# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode Template


START hilow_game

import random

    lower_bound = int(input("Enter the lower bound: "))
    upper_bound = int(input("Enter the upper bound: "))

WHILE lower_bound >= upper_bound
    print("Invalid range. The lower bound must be less than the upper bound.")
    lower_bound = int(input("Enter the lower bound: "))
    upper_bound = int(input("Enter the upper bound: "))

number_to_guess = random.randint(lower_bound, upper_bound)
guess = int(input(f"Guess a number between {lower_bound} and {upper_bound}: "))

while guess != number_to_guess:

    while guess < lower_bound or guess > upper_bound:
        print("Your guess is WRONG.")
        guess = int(input(f"Guess a number between {lower_bound} and {upper_bound}: "))

    if guess < number_to_guess:
        print("Higher!")
    else:
        print("Lower...")

    guess = int(inpur("Try again: "))

print("Correct! You did it!")
        


END hilow_game

